cabal-version:      3.0
name:               mc-follower
version:            0.1.0.0
synopsis:           Cardano indexer serving Midnight's main-chain data
description:
  Follows Cardano over node-to-node or node-to-client, indexes the data a
  Midnight node reads and serves it over gRPC.

license:            Apache-2.0
build-type:         Simple
extra-doc-files:    README.md

common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wpartial-fields
    -Wredundant-constraints -Wunused-packages

common lang
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    LambdaCase
    OverloadedStrings
    PatternSynonyms

library
  import:          warnings, lang
  hs-source-dirs:  src
  exposed-modules:
    McFollower.Block
    McFollower.BlockSource
    McFollower.BlockSource.ChainSync
    McFollower.BlockSource.N2C
    McFollower.BlockSource.N2N
    McFollower.BlockSource.N2N.Pending
    McFollower.BlockSource.Recent
    McFollower.LocalStateQuery
    McFollower.Network

  build-depends:
    , base                                                                     >=4.18   && <5
    , base16-bytestring
    , bytestring
    , cardano-api                                                              ^>=11.12
    , cardano-diffusion                                                        ^>=1.3
    , cardano-ledger-byron
    , cardano-ledger-core
    , cardano-slotting
    , containers
    , contra-tracer
    , io-classes:strict-stm
    , microlens
    , network
    , network-mux
    , ouroboros-consensus:{ouroboros-consensus, cardano, diffusion}            ^>=5.4
    , ouroboros-network:{api, framework, ouroboros-network, protocols}         ^>=2.0
    , random
    , stm
    , text
    , typed-protocols

  -- Indexer: extractor, store, sync loop and queries.
  exposed-modules:
    McFollower.Address
    McFollower.BlockFile
    McFollower.EraHistory
    McFollower.Extract
    McFollower.Query
    McFollower.Store
    McFollower.Store.Schema
    McFollower.Store.Sql
    McFollower.Sync
    McFollower.WatchSet

  build-depends:
    , base58-bytestring
    , bech32
    , cardano-binary
    , cardano-crypto-class
    , cardano-crypto-wrapper
    , cardano-ledger-alonzo
    , cardano-ledger-babbage
    , cardano-ledger-binary
    , cardano-ledger-mary
    , cardano-strict-containers
    , cborg
    , direct-sqlite
    , sop-extras
    , time

  -- gRPC server.
  exposed-modules:
    McFollower.Server
    McFollower.Server.Pool
    McFollower.Server.Proto

  build-depends:
    , grapesy
    , mc-follower:gen
    , proto-lens
    , unix

-- Code generated by proto-lens-protoc from proto/mc_follower.proto; see
-- scripts/gen-proto.sh.
library gen
  default-language: Haskell2010
  hs-source-dirs:   gen
  exposed-modules:
    Proto.McFollower
    Proto.McFollower_Fields

  build-depends:
    , base
    , proto-lens-runtime

executable mc-follower
  import:         warnings, lang
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts
  build-depends:
    , base
    , cardano-slotting
    , contra-tracer
    , mc-follower
    , optparse-applicative
    , ouroboros-consensus
    , text

  -- Indexer commands.
  build-depends:
    , filepath
    , ouroboros-network:api

test-suite mc-follower-test
  import:         warnings, lang
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  other-modules:
    Test.McFollower.Network
    Test.McFollower.Pending
    Test.McFollower.Points
    Test.McFollower.Recent

  -- Indexer tests.
  other-modules:
    Test.McFollower.Chain
    Test.McFollower.Extract
    Test.McFollower.Query
    Test.McFollower.Store

  build-depends:
    , base
    , bytestring
    , mc-follower
    , ouroboros-consensus
    , ouroboros-network:{api, protocols}
    , tasty
    , tasty-hunit

  -- Indexer tests.
  build-depends:
    , base16-bytestring
    , cardano-crypto-class
    , cardano-ledger-binary
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-slotting
    , containers
    , filepath
    , temporary
    , text
