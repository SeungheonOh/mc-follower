cabal-version:      3.0
name:               mc-follower
version:            0.1.0.0
synopsis:           Cardano indexer serving Midnight's main-chain data
description:
  Follows Cardano over node-to-node or node-to-client, indexes the data a
  Midnight node reads and serves it over gRPC.

license:            BSD-3-Clause
license-file:       LICENSE
build-type:         Simple
extra-doc-files:    README.md
extra-source-files: data/epoch-nonces/*.csv

common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wpartial-fields
    -Wredundant-constraints -Wunused-packages

common lang
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    LambdaCase
    OverloadedStrings
    PatternSynonyms

library
  import:          warnings, lang
  hs-source-dirs:  src

  -- Block source, era history and network parameters.
  exposed-modules:
    McFollower.Block
    McFollower.BlockSource
    McFollower.BlockSource.ChainSync
    McFollower.BlockSource.N2C
    McFollower.BlockSource.N2N
    McFollower.BlockSource.N2N.Pending
    McFollower.BlockSource.Recent
    McFollower.EraHistory
    McFollower.LocalStateQuery
    McFollower.Network

  -- Indexer: extractor, store, sync loop and queries.
  exposed-modules:
    McFollower.Address
    McFollower.BlockFile
    McFollower.Extract
    McFollower.Query
    McFollower.Store
    McFollower.Store.Schema
    McFollower.Store.Sql
    McFollower.Sync
    McFollower.WatchSet

  -- Epoch nonce and epoch data.
  exposed-modules:
    McFollower.EpochData.Driver
    McFollower.EpochData.MaxTxSize
    McFollower.EpochData.Mithril
    McFollower.EpochData.Producer
    McFollower.EpochData.Serve
    McFollower.EpochData.Stake
    McFollower.EpochData.Store
    McFollower.EpochNonceTable
    McFollower.Nonce
    McFollower.Nonce.TrustedState

  build-depends:
    , aeson
    , base                                                                     >=4.18   && <5
    , base16-bytestring
    , base58-bytestring
    , bech32
    , bytestring
    , cardano-api                                                              ^>=11.12
    , cardano-binary
    , cardano-crypto-class
    , cardano-crypto-wrapper
    , cardano-diffusion                                                        ^>=1.3
    , cardano-ledger-alonzo
    , cardano-ledger-api
    , cardano-ledger-babbage
    , cardano-ledger-binary
    , cardano-ledger-byron
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-dijkstra
    , cardano-ledger-mary
    , cardano-ledger-shelley
    , cardano-protocol-tpraos
    , cardano-slotting
    , cardano-strict-containers
    , cborg
    , containers
    , contra-tracer
    , direct-sqlite
    , file-embed
    , http-client
    , http-client-tls
    , http-types
    , io-classes:strict-stm
    , microlens
    , mtl
    , network
    , network-mux
    , ouroboros-consensus:{ouroboros-consensus, cardano, diffusion, protocol}  ^>=5.4
    , ouroboros-network:{api, framework, ouroboros-network, protocols}         ^>=2.0
    , random
    , serialise
    , sop-core
    , sop-extras
    , stm
    , strict-sop-core
    , text
    , time
    , typed-protocols

  -- gRPC server.
  exposed-modules:
    McFollower.Server
    McFollower.Server.Pool
    McFollower.Server.Proto

  build-depends:
    , grapesy
    , mc-follower:gen
    , proto-lens
    , unix

-- Code generated by proto-lens-protoc from proto/mc_follower.proto; see
-- scripts/gen-proto.sh.
library gen
  default-language: Haskell2010
  hs-source-dirs:   gen
  exposed-modules:
    Proto.McFollower
    Proto.McFollower_Fields

  build-depends:
    , base
    , proto-lens-runtime

executable mc-follower
  import:         warnings, lang
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts
  build-depends:
    , base
    , cardano-slotting
    , contra-tracer
    , mc-follower
    , optparse-applicative
    , ouroboros-consensus
    , text

  -- Indexer commands.
  build-depends:
    , filepath
    , ouroboros-network:api

  -- serve command.
  build-depends:
    , directory
    , network

  -- Epoch nonce and epoch data.
  build-depends:
    , async
    , bytestring
    , containers

test-suite mc-follower-test
  import:         warnings, lang
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  other-modules:
    Test.McFollower.Network
    Test.McFollower.Pending
    Test.McFollower.Points
    Test.McFollower.Recent

  -- Indexer tests.
  other-modules:
    Test.McFollower.Chain
    Test.McFollower.Extract
    Test.McFollower.Query
    Test.McFollower.Store

  -- gRPC server tests.
  other-modules:  Test.McFollower.Server

  -- Epoch nonce and epoch data tests.
  other-modules:
    Test.McFollower.EpochData
    Test.McFollower.EpochNonceTable
    Test.McFollower.EpochSync
    Test.McFollower.Fixtures
    Test.McFollower.Nonce

  build-depends:
    , aeson
    , base
    , base16-bytestring
    , bytestring
    , cardano-binary
    , cardano-crypto-class
    , cardano-data
    , cardano-ledger-api
    , cardano-ledger-babbage
    , cardano-ledger-binary
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-ledger-shelley
    , cardano-slotting
    , cborg
    , containers
    , contra-tracer
    , filepath
    , grapesy
    , grpc-spec
    , mc-follower
    , microlens
    , mtl
    , ouroboros-consensus:{ouroboros-consensus, cardano, protocol}
    , ouroboros-network:{api, protocols}
    , proto-lens
    , tasty
    , tasty-hunit
    , temporary
    , text
    , transformers

-- Development tool: the Praos state in a node's ledger snapshot, as a
-- trusted-state JSON. Not used by the indexer.
executable ledger-snapshot-praos-state
  import:         warnings, lang
  hs-source-dirs: dev
  main-is:        LedgerSnapshotState.hs
  build-depends:
    , base
    , bytestring
    , cardano-binary
    , cardano-protocol-tpraos
    , cborg
    , containers
    , mc-follower
    , ouroboros-consensus:{ouroboros-consensus, cardano, protocol}
    , sop-extras
    , strict-sop-core
    , text

-- Checks against the live preview network, Koios and Mithril; run with
-- MC_FOLLOWER_LIVE=1.
test-suite mc-follower-live
  import:         warnings, lang
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Live.hs
  ghc-options:    -threaded
  other-modules:  Test.McFollower.Fixtures
  build-depends:
    , aeson
    , base
    , base16-bytestring
    , bytestring
    , cardano-binary
    , cardano-crypto-class
    , cardano-ledger-core
    , cardano-slotting
    , cborg
    , containers
    , contra-tracer
    , http-client
    , mc-follower
    , ouroboros-consensus:{ouroboros-consensus, cardano, protocol}
    , ouroboros-network:api
    , tasty
    , tasty-hunit
    , text
