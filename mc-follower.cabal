cabal-version:      3.0
name:               mc-follower
version:            0.1.0.0
synopsis:           Cardano indexer serving Midnight's main-chain data
description:
  Follows Cardano over node-to-node or node-to-client, indexes the data a
  Midnight node reads and serves it over gRPC.

license:            Apache-2.0
build-type:         Simple
extra-doc-files:    README.md
extra-source-files: data/epoch-nonces/*.csv

common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wpartial-fields
    -Wredundant-constraints -Wunused-packages

common lang
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    LambdaCase
    OverloadedStrings
    PatternSynonyms

library
  import:          warnings, lang
  hs-source-dirs:  src
  exposed-modules:
    McFollower.Block
    McFollower.BlockSource
    McFollower.BlockSource.ChainSync
    McFollower.BlockSource.N2C
    McFollower.BlockSource.N2N
    McFollower.BlockSource.N2N.Pending
    McFollower.BlockSource.Recent
    McFollower.LocalStateQuery
    McFollower.Network
    -- Epoch nonce and epoch data
    McFollower.EpochData.MaxTxSize
    McFollower.EpochData.Mithril
    McFollower.EpochData.Stake
    McFollower.EpochData.Store
    McFollower.EpochNonceTable
    McFollower.EraHistory
    McFollower.Nonce
    McFollower.Nonce.TrustedState

  build-depends:
    , base                                                                     >=4.18   && <5
    , base16-bytestring
    , bytestring
    , cardano-api                                                              ^>=11.12
    , cardano-diffusion                                                        ^>=1.3
    , cardano-ledger-byron
    , cardano-ledger-core
    , cardano-slotting
    , containers
    , contra-tracer
    , io-classes:strict-stm
    , microlens
    , network
    , network-mux
    , ouroboros-consensus:{ouroboros-consensus, cardano, diffusion}            ^>=5.4
    , ouroboros-network:{api, framework, ouroboros-network, protocols}         ^>=2.0
    , random
    , stm
    , text
    , typed-protocols
    -- Epoch nonce and epoch data
    , aeson
    , bech32
    , cardano-crypto-class
    , cardano-ledger-alonzo
    , cardano-ledger-api
    , cardano-ledger-conway
    , cardano-ledger-dijkstra
    , cardano-ledger-shelley
    , cardano-protocol-tpraos
    , cborg
    , file-embed
    , http-client
    , http-client-tls
    , http-types
    , mtl
    , ouroboros-consensus:protocol
    , serialise
    , sop-core
    , sop-extras
    , strict-sop-core

executable mc-follower
  import:         warnings, lang
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts
  build-depends:
    , base
    , cardano-slotting
    , contra-tracer
    , mc-follower
    , optparse-applicative
    , ouroboros-consensus
    , text

test-suite mc-follower-test
  import:         warnings, lang
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  other-modules:
    Test.McFollower.Network
    Test.McFollower.Pending
    Test.McFollower.Points
    Test.McFollower.Recent
    -- Epoch nonce and epoch data
    Test.McFollower.EpochData
    Test.McFollower.EpochNonceTable
    Test.McFollower.Fixtures
    Test.McFollower.Nonce

  build-depends:
    , base
    , bytestring
    , mc-follower
    , ouroboros-consensus
    , ouroboros-network:{api, protocols}
    , tasty
    , tasty-hunit
    -- Epoch nonce and epoch data
    , aeson
    , base16-bytestring
    , cardano-binary
    , cardano-crypto-class
    , cardano-data
    , cardano-ledger-api
    , cardano-ledger-babbage
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-shelley
    , cardano-slotting
    , cborg
    , containers
    , microlens
    , mtl
    , ouroboros-consensus:{cardano, protocol}
    , text

-- Development tool: the Praos state in a node's ledger snapshot, as a
-- trusted-state JSON. Not used by the indexer.
executable ledger-snapshot-praos-state
  import:         warnings, lang
  hs-source-dirs: dev
  main-is:        LedgerSnapshotState.hs
  build-depends:
    , base
    , bytestring
    , cardano-binary
    , cardano-protocol-tpraos
    , cborg
    , containers
    , mc-follower
    , ouroboros-consensus:{ouroboros-consensus, cardano, protocol}
    , sop-extras
    , strict-sop-core
    , text

-- Checks against the live preview network, Koios and Mithril; run with
-- MC_FOLLOWER_LIVE=1.
test-suite mc-follower-live
  import:         warnings, lang
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Live.hs
  ghc-options:    -threaded
  other-modules:  Test.McFollower.Fixtures
  build-depends:
    , aeson
    , base
    , base16-bytestring
    , bytestring
    , cardano-binary
    , cardano-crypto-class
    , cardano-ledger-core
    , cardano-slotting
    , cborg
    , containers
    , contra-tracer
    , http-client
    , mc-follower
    , ouroboros-consensus:{ouroboros-consensus, cardano, protocol}
    , ouroboros-network:api
    , tasty
    , tasty-hunit
    , text
