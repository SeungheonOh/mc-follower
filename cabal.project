-- Package set pinned to cardano-node 11.2.3: the index states, constraints
-- and package flags below are taken from that tag's cabal.project and trimmed
-- to what this project needs.

repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

index-state:
  , hackage.haskell.org 2026-09-29T11:48:37Z
  , cardano-haskell-packages 2026-11-18T19:33:14Z

packages: .

tests: True

test-show-details: direct

constraints:
  -- The library versions shipped in cardano-node 11.2.3.
  , cardano-api ^>=11.12
  , ouroboros-consensus ^>=5.4
  , ouroboros-network ^>=2.0
  , cardano-diffusion ^>=1.3
  -- Carried over from cardano-node 11.2.3.
  , any.crypton-x509-system < 1.6.8 || >= 1.7
  , any.proto-lens >= 0.7.1.7
  , any.alfred-margaret < 2.1.1.0 || > 2.1.1.0
  , any.grapesy >= 1.2.1

package acts
  flags: -finitary

package cryptonite
  flags: -support_rdrand

package bitvec
  flags: -simd

-- Use stock libsodium and the VRF code bundled in cardano-crypto-praos rather
-- than IOG's libsodium fork.
package cardano-crypto-praos
  flags: -external-libsodium-vrf
